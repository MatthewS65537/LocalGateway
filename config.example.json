{
  "server": {
    "host": "127.0.0.1",
    "port": 3456,
    "api_key": null,
    "api_keys": [
      {
        "id": "home-agent",
        "key": "REPLACE_WITH_A_CLIENT_KEY",
        "label": "My home assistant",
        "enabled": true,
        "rpm": 60,
        "daily_budget_usd": 1.0,
        "monthly_budget_usd": null,
        "model_allowlist": []
      }
    ],
    "routing_mode": "explore",
    "routing_decay": 0.75,
    "stats_routing_enabled": true,
    "circuit_breaker_enabled": true,
    "circuit_breaker_threshold": 3,
    "circuit_breaker_backoff_s": 60.0,
    "probe_enabled": true,
    "probe_interval_s": 3600.0,
    "probe_max_tokens": 64,
    "chart_enabled": false,
    "cache_affinity_enabled": false,
    "cache_affinity_ttl_sec": 300,
    "max_inflight_before_spill": null,
    "usage_retention_days": 30,
    "log_retention_lines": 10000,
    "tokenizer": "auto",
    "alert_webhook_url": null
  },
  "providers": [
    {
      "id": "my-provider",
      "name": "My Provider",
      "base_url": "https://api.example.com/v1",
      "api_key": "REPLACE_WITH_YOUR_API_KEY",
      "headers": {},
      "timeout": 120.0,
      "enabled": true,
      "stream_idle_timeout": 60.0,
      "avatar": ""
    }
  ],
  "models": [
    {
      "id": "my-model",
      "backends": [
        {
          "provider": "my-provider",
          "model": "upstream-model-name",
          "priority": 1,
          "enabled": true,
          "context_length": 128000,
          "max_output_tokens": 8192,
          "cache_supported": null
        }
      ],
      "description": "Example logical model with a single backend.",
      "context_length": null,
      "enabled": true,
      "capabilities": {
        "text": true,
        "vision": false,
        "audio": false,
        "tools": true,
        "json_mode": false,
        "parallel_tool_calls": false,
        "streaming": true
      },
      "modality": "text",
      "max_output_tokens": null,
      "endpoint": "chat",
      "tags": [],
      "aliases": ["my-model-alias"],
      "default_params": {},
      "display_name": "My Model",
      "avatar": "",
      "time_routing": {
        "enabled": false,
        "timezone": "UTC",
        "slots": [
          {
            "id": "peak-9-17",
            "name": "Peak hours",
            "start_hour": 9,
            "end_hour": 17,
            "days_of_week": [0, 1, 2, 3, 4],
            "active_providers": ["my-provider:upstream-model-name"],
            "enabled": true
          }
        ]
      }
    },
    {
      "id": "my-embedder",
      "endpoint": "embeddings",
      "description": "Example embeddings model (POST /v1/embeddings).",
      "backends": [
        {
          "provider": "my-provider",
          "model": "some-embedding-model",
          "priority": 1,
          "enabled": true
        }
      ]
    }
  ],
  "pricing": {
    "my-provider:upstream-model-name": {
      "input": 0.0,
      "output": 0.0,
      "cache_read": null,
      "cache_write": null
    },
    "my-provider:some-embedding-model": {
      "input": 0.0,
      "output": 0.0,
      "cache_read": null,
      "cache_write": null
    }
  }
}